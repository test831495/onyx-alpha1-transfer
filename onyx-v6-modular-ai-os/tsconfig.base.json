{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@onyx/contracts": [
        "packages/contracts/src/index"
      ],
      "@onyx/core": [
        "packages/core/src/index"
      ],
      "@onyx/plugin-sdk": [
        "packages/plugin-sdk/src/index"
      ],
      "@onyx/privacy": [
        "packages/privacy/src/index"
      ],
      "@onyx/ui": [
        "packages/ui/src/index"
      ],
      "@onyx/avatar-runtime": [
        "packages/avatar-runtime/src/index"
      ]
    },
    "jsx": "react-jsx"
  }
}
