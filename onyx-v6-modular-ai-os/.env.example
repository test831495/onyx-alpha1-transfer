# Public frontend configuration
VITE_ONYX_API_BASE=/.netlify/functions
VITE_ONYX_AGENT_ID=agent_replace_me
VITE_DEFAULT_MODE=nova

# Canonical public Microsoft SPA configuration for the browser runtime.
# No client secret or token is permitted in browser-visible configuration.
ONYX_MS_CLIENT_ID=
ONYX_MS_TENANT_ID=common
ONYX_MS_REDIRECT_URI=http://localhost:5173
ONYX_MS_AUTHORITY=https://login.microsoftonline.com/common

# Legacy Microsoft names are deprecated for browser runtime and are not used by the SPA.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=server-only-placeholder-unused-by-current-spa
MICROSOFT_TENANT_ID=common

# Server-only secrets. Never expose these as VITE_ or ONYX_MS_ variables.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
NEWS_API_KEY=
MARKET_DATA_API_KEY=
ONYX_SESSION_SECRET=replace_with_long_random_value
