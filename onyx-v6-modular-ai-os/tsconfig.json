{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "netlify/functions/**/*.ts",
    "netlify/functions/**/*.mts",
    "packages/*/src/**/*.ts"
  ]
}
